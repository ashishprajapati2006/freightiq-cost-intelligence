# ==============================================================================
# FreightIQ — Git Ignore Configuration
# ==============================================================================

# Environment variables and secrets (NEVER commit secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python artifacts and caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Frontend builds and dependencies
node_modules/
dist/
build/
.vercel/
.turbo/
.npm/

# IDE, Editors, and OS files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-workspace
*.sublime-project

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Storage uploads and runtime artifacts (preserve .gitkeep)
backend/storage/runs/*
!backend/storage/runs/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# Temporary / Scratch files
*.bak
*.tmp
*.temp
