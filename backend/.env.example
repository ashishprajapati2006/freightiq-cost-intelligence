# FreightIQ Backend API — Environment Configuration Example
# See the canonical root '.env.example' for full project variables.

# Server Environment
ENVIRONMENT=development
PORT=8001
HOST=127.0.0.1

# CORS Configuration (comma-separated origins)
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
ALLOW_VERCEL_PREVIEWS=true

# Core Analytical Defaults
ANOMALY_THRESHOLD_PCT=20.0
MAX_HISTORICAL_WEEKS=8
NOTE_DATE_WINDOW_DAYS=42

# Upload Limits (25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400

# Project Paths (optional; auto-detected if empty)
# PROJECT_ROOT=
