# ==============================================================================
# FreightIQ — Environment Variables & Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit '.env' or real credentials into Git.
# - In production:
#     - Frontend variables must be configured in your Vercel Project Settings.
#     - Backend variables must be configured in your Render Web Service Dashboard.
# ==============================================================================

# ==============================================================================
# 1. FRONTEND CONFIGURATION (Vercel / Local)
# ==============================================================================
# The base URL of the FreightIQ FastAPI backend.
# - Local dev: http://127.0.0.1:8001/api/v1 (or http://localhost:8001/api/v1)
# - Production (Vercel): https://freightiq-cost-intelligence-8.onrender.com/api/v1
# Note: FREIGHTIQ_API_BASE_URL and VITE_API_BASE_URL are both recognized.
FREIGHTIQ_API_BASE_URL=http://127.0.0.1:8001/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# ==============================================================================
# 2. BACKEND SERVER & HOSTING (Render / Local)
# ==============================================================================
# Server environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Server binding host and port (Render provides $PORT automatically)
HOST=127.0.0.1
PORT=8001

# Allowed Frontend Origins for CORS
# Comma-separated list of allowed origins.
# - Local dev: http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173
# - Production: https://YOUR-VERCEL-DOMAIN.vercel.app
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Enable safe regex matching for Vercel preview domains (e.g. https://*.vercel.app)
# Values: 'true' or 'false'
ALLOW_VERCEL_PREVIEWS=true

# ==============================================================================
# 3. ANALYTICAL ENGINE PARAMETERS (Deterministic Case Study Contract)
# ==============================================================================
# Anomaly threshold percentage (Case study specification: 20%)
ANOMALY_THRESHOLD_PCT=20.0

# Trailing historical observation window (Case study specification: 8 weeks)
MAX_HISTORICAL_WEEKS=8

# Qualitative context note matching window in days (Case study specification: 42 days / 6 weeks)
NOTE_DATE_WINDOW_DAYS=42

# Maximum uploaded CSV file size in bytes (Default: 25 MB = 26,214,400 bytes)
MAX_UPLOAD_SIZE_BYTES=26214400

# Optional custom project root (auto-discovered if left blank)
# PROJECT_ROOT=
